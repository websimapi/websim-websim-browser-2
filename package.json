{
  "name": "websim-browser",
  "version": "1.0.0",
  "description": "A custom browser for WebSim.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "setup": "node setup.js"
  },
  "keywords": ["websim", "browser", "electron"],
  "author": "WebSim Browser Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.8.0"
  },
  "build": {
    "appId": "com.websim.browser",
    "productName": "WebSim Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

